---
layout: default
---
{% comment %}
  Local override of al_folio_core's cv layout: same RenderCV page, plus a visible download button.
  The PDF is produced by bin/build_cv.py during deploy.
{% endcomment %}
{% if page.cv_pdf %}
  <div style="display: flex; justify-content: flex-end; margin-bottom: -2.5rem; position: relative; z-index: 1;">
    <a
      class="btn btn-sm z-depth-0"
      role="button"
      href="{{ page.cv_pdf | relative_url }}"
      download
      style="border: 1px solid var(--global-theme-color); color: var(--global-theme-color); font-size: 0.85rem; margin-right: 3.5rem;"
    >
      <i class="fa-solid fa-file-arrow-down"></i> Download PDF
    </a>
  </div>
{% endif %}
{% al_folio_cv_render %}
