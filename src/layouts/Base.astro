---
import 'katex/dist/katex.min.css';
// Self-hosted Inter fallback for systems without the preferred local system fonts.
import '@fontsource-variable/inter/opsz.css';
import '@fontsource-variable/inter/opsz-italic.css';
import '../styles/global.css';
import { NAV, SITE, emailParts, socials } from '../lib/data';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  schema?: object[];
}
const { title, description = SITE.description, image = '/assets/img/og/davestia.png', type = 'website', noindex = false, schema = [] } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name}, ${SITE.author}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const path = Astro.url.pathname;
const [eu, ed] = emailParts();
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.author,
  url: new URL('/', Astro.site).href,
  jobTitle: 'PhD candidate in Mechanical Engineering',
  affiliation: [{ '@type': 'CollegeOrUniversity', name: 'Bursa Uludağ University' }, { '@type': 'Organization', name: 'Mertay Makina' }],
  sameAs: [
    `https://orcid.org/${SITE.orcid}`,
    `https://www.linkedin.com/in/${socials.linkedin_username}`,
    `https://github.com/${socials.github_username}`,
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/brand/symbol.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/feed.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Respect the system until the visitor chooses a persistent preference.
      try { const t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}
    </script>
    {[person, ...schema].map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body data-eu={eu} data-ed={ed}>
    <a class="sr-only skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="wrap">
        <a class="brand" href="/" aria-label="Davestia Lab, home">
          <img class="logo-light" src="/brand/logo.svg" alt="Davestia Lab" width="153" height="34" />
          <img class="logo-dark" src="/brand/logo-white.svg" alt="Davestia Lab" width="153" height="34" />
        </a>
        <div class="toolbar">
          <nav class="nav" id="nav" aria-label="Main">
            {NAV.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
          </nav>
          <button class="tb-btn theme-toggle" type="button" data-theme-toggle aria-label="Switch light or dark theme" title="Light or dark">
            <svg class="i-sun" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="3.6" /><path d="M10 1.8v2.2M10 16v2.2M1.8 10h2.2M16 10h2.2M4.2 4.2l1.6 1.6M14.2 14.2l1.6 1.6M4.2 15.8l1.6-1.6M14.2 5.8l1.6-1.6" /></svg>
            <svg class="i-moon" viewBox="0 0 20 20" aria-hidden="true"><path d="M16.5 12.6A7 7 0 0 1 7.4 3.5a7 7 0 1 0 9.1 9.1Z" /></svg>
          </button>
          <button class="tb-btn menu" type="button" aria-expanded="false" aria-controls="nav" aria-label="Menu" data-menu>
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3.5 7h13M3.5 13h13" /></svg>
          </button>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <a href="/" aria-label="Davestia Lab, home">
          <img class="logo-light" src="/brand/logo.svg" alt="Davestia Lab" width="117" height="26" />
          <img class="logo-dark" src="/brand/logo-white.svg" alt="Davestia Lab" width="117" height="26" />
        </a>
        <nav aria-label="Profiles">
          <span class="email-protect" data-label="Email">Email</span>
          <a href={`https://orcid.org/${SITE.orcid}`}>ORCID</a>
          <a href={`https://www.linkedin.com/in/${socials.linkedin_username}`}>LinkedIn</a>
          <a href={`https://github.com/${socials.github_username}`}>GitHub</a>
          <a href="/feed.xml">RSS</a>
          <a href="/id/" lang="id">Bahasa Indonesia</a>
        </nav>
        <p class="fine">© {new Date().getFullYear()} Davestia Lab, David Setiadhi. Publication list and metrics update every week from ORCID and OpenAlex.</p>
      </div>
    </footer>
    <script is:inline>
      (function () {
        // Email is assembled in the browser so the address never appears whole in the HTML.
        var b = document.body, u = atob(b.dataset.eu || ''), d = atob(b.dataset.ed || '');
        document.querySelectorAll('.email-protect').forEach(function (el) {
          var a = document.createElement('a');
          a.href = 'mailto:' + u + '@' + d;
          // data-label sets the link text; without it the address itself is shown.
          a.textContent = el.dataset.label || u + '@' + d;
          if (el.className.indexOf('btn') > -1) a.className = el.className.replace('email-protect', '').trim();
          el.replaceWith(a);
        });
        var menu = document.querySelector('[data-menu]'), nav = document.getElementById('nav');
        function setMenu(open) {
          nav.classList.toggle('open', open);
          menu.setAttribute('aria-expanded', String(open));
        }
        if (menu) {
          menu.addEventListener('click', function (e) { e.stopPropagation(); setMenu(!nav.classList.contains('open')); });
          // Close the navigation sheet on outside click or Escape.
          document.addEventListener('click', function (e) { if (!nav.contains(e.target)) setMenu(false); });
          document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && nav.classList.contains('open')) { setMenu(false); menu.focus(); } });
        }
        var tg = document.querySelector('[data-theme-toggle]');
        tg && tg.addEventListener('click', function () {
          var root = document.documentElement;
          var dark = root.dataset.theme === 'dark' || (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
          root.dataset.theme = dark ? 'light' : 'dark';
          try { localStorage.setItem('theme', root.dataset.theme); } catch (e) {}
          window.dispatchEvent(new Event('themechange'));
        });
      })();
    </script>
  </body>
</html>
