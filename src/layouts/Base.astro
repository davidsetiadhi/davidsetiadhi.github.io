---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { NAV, SITE, emailParts, socials } from '../lib/data';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  schema?: object[];
}
const { title, description = SITE.description, image = '/assets/img/og/davestia.png', type = 'website', noindex = false, schema = [] } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name}, ${SITE.author}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const path = Astro.url.pathname;
const [eu, ed] = emailParts();
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.author,
  url: new URL('/', Astro.site).href,
  jobTitle: 'PhD candidate in Mechanical Engineering',
  affiliation: [{ '@type': 'CollegeOrUniversity', name: 'Bursa Uludağ University' }, { '@type': 'Organization', name: 'Mertay Makina' }],
  sameAs: [
    `https://orcid.org/${SITE.orcid}`,
    `https://www.linkedin.com/in/${socials.linkedin_username}`,
    `https://github.com/${socials.github_username}`,
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/brand/symbol.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/feed.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#061F3E" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,400..800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap" />
    <script is:inline>
      // Light by default; dark only after the visitor picks it with the Theme button.
      let t = 'light'; try { t = localStorage.getItem('theme') || 'light'; } catch {} document.documentElement.dataset.theme = t;
    </script>
    {[person, ...schema].map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body data-eu={eu} data-ed={ed}>
    <a class="sr-only skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="wrap">
        <a class="brand" href="/" aria-label="Davestia Lab, home">
          <img class="logo-light" src="/brand/logo.svg" alt="Davestia Lab" width="153" height="34" />
          <img class="logo-dark" src="/brand/logo-white.svg" alt="Davestia Lab" width="153" height="34" />
        </a>
        <nav class="nav" id="nav" aria-label="Main">
          {NAV.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
          <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch light or dark theme">Theme</button>
        </nav>
        <button class="menu" type="button" aria-expanded="false" aria-controls="nav" data-menu>Menu</button>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <a href="/" aria-label="Davestia Lab, home">
          <img class="logo-light" src="/brand/logo.svg" alt="Davestia Lab" width="117" height="26" />
          <img class="logo-dark" src="/brand/logo-white.svg" alt="Davestia Lab" width="117" height="26" />
        </a>
        <nav aria-label="Profiles">
          <span class="email-protect" data-label="Email">Email</span>
          <a href={`https://orcid.org/${SITE.orcid}`}>ORCID</a>
          <a href={`https://www.linkedin.com/in/${socials.linkedin_username}`}>LinkedIn</a>
          <a href={`https://github.com/${socials.github_username}`}>GitHub</a>
          <a href="/feed.xml">RSS</a>
          <a href="/id/" lang="id">Bahasa Indonesia</a>
        </nav>
        <p class="fine">© {new Date().getFullYear()} Davestia Lab, David Setiadhi. Publication list and metrics update every week from ORCID and OpenAlex.</p>
      </div>
    </footer>
    <script is:inline>
      (function () {
        // Email is assembled in the browser so the address never appears whole in the HTML.
        var b = document.body, u = atob(b.dataset.eu || ''), d = atob(b.dataset.ed || '');
        document.querySelectorAll('.email-protect').forEach(function (el) {
          var a = document.createElement('a');
          a.href = 'mailto:' + u + '@' + d;
          // data-label sets the link text; without it the address itself is shown.
          a.textContent = el.dataset.label || u + '@' + d;
          if (el.className.indexOf('btn') > -1) a.className = el.className.replace('email-protect', '').trim();
          el.replaceWith(a);
        });
        var menu = document.querySelector('[data-menu]'), nav = document.getElementById('nav');
        menu && menu.addEventListener('click', function () {
          var open = nav.classList.toggle('open');
          menu.setAttribute('aria-expanded', String(open));
        });
        var tg = document.querySelector('[data-theme-toggle]');
        tg && tg.addEventListener('click', function () {
          var root = document.documentElement;
          var dark = root.dataset.theme === 'dark';
          root.dataset.theme = dark ? 'light' : 'dark';
          try { localStorage.setItem('theme', root.dataset.theme); } catch (e) {}
          window.dispatchEvent(new Event('themechange'));
        });
      })();
    </script>
  </body>
</html>
