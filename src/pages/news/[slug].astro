---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { fmtDate } from '../../lib/data';

export async function getStaticPaths() {
  return (await getCollection('news')).map((n) => ({ params: { slug: n.id }, props: { n } }));
}
const { n } = Astro.props;
const { Content } = await render(n);
const when = fmtDate(n.data.date, { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={n.data.title ?? `News, ${when}`}>
  <PageHead title={n.data.title ?? when} crumb={{ href: '/news/', label: 'News' }} />
  <div class="page-body"><div class="wrap"><article class="prose"><Content /></article></div></div>
</Base>
